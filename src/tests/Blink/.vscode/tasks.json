{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Program with OpenOCD",
      "type": "shell",
      "command": "openocd",
      "args": [
        "-f",
        "interface/cmsis-dap.cfg",
        "-f",
        "target/at91samdXX.cfg",
        "-c",
        "program ${workspaceFolder}/out/HTSAMD20RB-Blinky_LowLevel/default.elf verify reset exit"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
